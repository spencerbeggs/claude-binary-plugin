# =============================================================================
# Local OTEL Environment Variables
# =============================================================================
# Source this file to send telemetry to the local Docker observability stack.
#
# Usage:
#   source docker/env.local
#   claude --plugin-dir ./plugin
#
# This configures BOTH:
#   1. Claude Code CLI telemetry (gRPC on :4317 with x-api-key auth)
#   2. Plugin sidecar telemetry (HTTP on :4318, no auth needed)
# =============================================================================

# --- Claude Code CLI telemetry (built-in OTEL) ---
export CLAUDE_CODE_ENABLE_TELEMETRY="1"
export OTEL_METRICS_EXPORTER="otlp"
export OTEL_LOGS_EXPORTER="otlp"
export OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
export OTEL_EXPORTER_OTLP_HEADERS="x-api-key=local-dev-key"
