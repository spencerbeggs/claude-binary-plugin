        "tooltip": {
          "mode": "single",
          "sort": "asc"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "legend": {
          "values": [
            "value",
            "percent"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": []
        },
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cacheRead"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cache Read"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cacheCreation"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cache Creation"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "input"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Input"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Output"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total[$__range]))",
          "refId": "A",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
