{
	"name": "claude-binary-plugin-monorepo",
	"private": true,
	"type": "module",
	"workspaces": ["package", "plugin"],
	"scripts": {
		"build": "turbo run build:dev build:prod --log-order=grouped --log-prefix=none",
		"ci:build": "CI=\"true\" turbo run build",
		"ci:test": "turbo run test",
		"ci:version": "changeset version && biome format --write",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"lint:tsdoc": "eslint --config ./lib/configs/eslint.config.ts --ignore-pattern '**/*.test.ts'",
		"prepare": "husky",
		"test": "turbo run test",
		"typecheck": "turbo run types:check",
		"types:check": "tsgo --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@changesets/cli": "^2.30.0",
		"@commitlint/cli": "^20.4.3",
		"@commitlint/config-conventional": "^20.4.3",
		"@savvy-web/changesets": "^0.7.3",
		"@savvy-web/commitlint": "^0.5.1",
		"@savvy-web/lint-staged": "^0.7.1",
		"@types/node": "^25.5.0",
		"@typescript/native-preview": "^7.0.0-dev.20260331.1",
		"commitizen": "^4.3.1",
		"husky": "^9.1.0",
		"lint-staged": "^16.4.0",
		"markdownlint-cli2": "^0.22.0",
		"markdownlint-cli2-formatter-codequality": "^0.0.7",
		"turbo": "^2.9.2",
		"typescript": "^6.0.2"
	},
	"packageManager": "bun@1.3.9",
	"engines": {
		"bun": ">=1.3.9"
	},
	"engineStrict": true,
	"devEngines": {
		"runtime": [
			{
				"name": "bun",
				"version": "1.3.9",
				"onFail": "ignore"
			}
		],
		"packageManager": {
			"name": "bun",
			"version": "1.3.9",
			"onFail": "ignore"
		}
	},
	"trustedDependencies": ["@parcel/watcher", "msgpackr-extract", "protobufjs"]
}
