{
	"extends": ["//"],
	"tasks": {
		"build:prod": {
			"cache": true,
			"dependsOn": ["types:check"],
			"outputLogs": "errors-only",
			"outputs": ["*.plugin"]
		},
		"types:check": {
			"cache": true,
			"dependsOn": ["^build:dev"],
			"outputLogs": "errors-only",
			"outputs": ["dist/.tsbuildinfo.lib"]
		}
	}
}
