{
	"$schema": "https://turborepo.com/schema.v2.json",
	"globalPassThroughEnv": [],
	"tasks": {
		"build": {
			"dependsOn": ["typecheck", "compile"],
			"inputs": [
				"$TURBO_DEFAULTS$",
				"bun.lock",
				"package.json",
				"src/**/*",
				"lib/scripts/build.mts",
				"lib/builder/**/*",
				"bunfig.toml",
				"tsconfig.json",
				".npmignore"
			],
			"outputs": ["bin/**", "dist/**"]
		},
		"compile": {
			"dependsOn": ["typecheck"],
			"inputs": [
				"$TURBO_DEFAULTS$",
				"bun.lock",
				"package.json",
				"src/**/*",
				"lib/scripts/build.mts",
				"lib/builder/**/*",
				"bunfig.toml",
				"tsconfig.json",
				".npmignore"
			],
			"outputs": ["bin/**", "dist/**"]
		},
		"test": {
			"cache": false,
			"dependsOn": ["build"]
		},
		"test:ai": {
			"cache": false,
			"dependsOn": ["build"]
		},
		"typecheck": {
			"inputs": ["src/**", "tsconfig.json"]
		}
	}
}
